# Bu dosyayı server/.env olarak kopyalayıp kendi değerlerinle doldur.
# server/.env repoya girmez (.gitignore). Gerçek değerleri asla bu dosyaya yazma.

# Sunucunun dinleyeceği port
PORT=4000

# Supabase proje adresi
# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase gizli anahtarı (yalnızca sunucuda kalır, istemciye ASLA verilmez)
# Supabase > Project Settings > API Keys > "Secret key" (eski projelerde: service_role)
SUPABASE_SECRET_KEY=

# Postgres bağlantı adresi
# Supabase > Connect > "Session pooler" (şifre yerine kendi veritabanı şifreni yaz)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:SIFRE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
